{
  "name": "halobestie-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "api": "tsx server/index.ts",
    "customer": "EXPO_PUBLIC_APP_ROLE=customer expo start --port 8081",
    "bestie": "EXPO_PUBLIC_APP_ROLE=bestie expo start --port 8082",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/session.test.ts",
    "build:customer": "EXPO_PUBLIC_APP_ROLE=customer expo export --platform web --output-dir dist/customer",
    "build:bestie": "EXPO_PUBLIC_APP_ROLE=bestie expo export --platform web --output-dir dist/bestie",
    "start": "concurrently -k \"npm run api\" \"npm run customer -- --web\" \"npm run bestie -- --web\""
  },
  "dependencies": {
    "@expo/metro-runtime": "^58.0.17",
    "cors": "^2.8.5",
    "expo": "~58.0.26",
    "expo-status-bar": "~58.0.5",
    "express": "^5.1.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
