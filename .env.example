# Use your computer's LAN IP for physical phones; add browser origins below.
EXPO_PUBLIC_API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082
# Set true when serving through HTTPS. No public identity tokens are used.
COOKIE_SECURE=false
# Optional coturn REST credentials. Keep the shared secret server-side.
# TURN_URLS=turn:your-relay.example:3478?transport=udp,turns:your-relay.example:5349?transport=tcp
# TURN_SECRET=
VOICE_FORCE_RELAY=false
LOG_REQUESTS=false
